NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_DATABASE=isocal
DB_SSL=false

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=15m

WS_PATH=/ws

# SMTP Email Configuration (e.g. Gmail)
# For Gmail: Use an App Password (Mật khẩu ứng dụng 16 chữ số từ Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="ISOCAL Platform" <your_email@gmail.com>

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=isocal
